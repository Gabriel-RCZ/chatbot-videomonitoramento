{
  "name": "chatbot-videomonitoramento",
  "version": "1.0.0",
  "description": "Chatbot da Gerência de Videomonitoramento",
  "main": "FrontEnd/main.js",
  "author": "Gerência de Videomonitoramento",
  "scripts": {
    "painel": "electron FrontEnd/main.js",
    "build": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "moment-timezone": "^0.5.45",
    "openai": "^4.78.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.4"
  },
  "volta": {
    "node": "22.23.2"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.videomonitoramento.chatbot",
    "productName": "Chatbot Videomonitoramento",
    "directories": {
      "output": "dist"
    },
    "files": [
      "FrontEnd/**/*",
      "chatbot.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "Modelo de importação de câmeras.xlsx",
        "to": "Modelo de importação de câmeras.xlsx"
      },
      {
        "from": "Termo de Responsabilidade.pdf",
        "to": "Termo de Responsabilidade.pdf"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/puppeteer/**/*",
      "node_modules/puppeteer-core/**/*",
      "node_modules/whatsapp-web.js/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chatbot Videomonitoramento"
    }
  }
}